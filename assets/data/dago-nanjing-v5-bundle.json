  "passages": {
    "Gate":{"code":"NJ-001","title":"南京外城","loc":"南京外城","text":["大興二十年的南京，雨後石道仍帶著潮色。城門口的驛馬、茶棚、南市帳房與官署差役把許多消息帶到同一條街上。","你今日只在南京行動。遠方的南陽、崑崙、銀川與五毒，都只以信、帳、傳聞與舊人之名進入這座城。"],"choices":[{"text":"去茶棚聽南來商旅說話","to":"Tea","kind":"question","skill":"listen","dc":8,"fx":{"hunger":1,"fatigue":1}},{"text":"到驛舍問北路急信","to":"Relay","kind":"question","skill":"office","dc":10,"fx":{"fatigue":1,"suspicion":1}},{"text":"繞去秦淮河埠看貨船","to":"River","kind":"action","skill":"observe","dc":10,"fx":{"fatigue":2}},{"text":"回借住小院溫課練功","to":"Training","kind":"training","skill":null,"dc":0,"fx":{"fatigue":-1}}]},
    "Tea":{"code":"NJ-002","title":"城門茶棚","loc":"南京茶棚","text":["茶博士把粗碗推到你面前。旁桌兩名商旅提到江郡北虎商會、南陽商銀與江夏糧船。","有人低聲說，李遠已向南行，另有一封信要趕在局勢變壞前送到南京西街。"],"choices":[{"text":"請茶博士說清南陽商銀異動","to":"Ledger","kind":"question","skill":"speech","dc":10,"fx":{"coin":-1,"suspicion":1},"success":"茶博士收了錢，說南陽近日有大額拆借，名義乾淨，走向卻怪。","failure":"茶博士把碗往桌上一扣，說這種話不該在城門口問。"},{"text":"側耳聽商旅是否提到崑崙","to":"Kunlun","kind":"question","skill":"listen","dc":10,"fx":{"suspicion":1},"gain":"崑崙受襲傳聞"},{"text":"跟蹤離席的青衣商旅","to":"Alley","kind":"action","skill":"hide","dc":12,"fx":{"fatigue":3,"suspicion":2}},{"text":"回南京外城","to":"Gate","kind":"action","skill":null,"dc":0,"fx":{}}]},
    "Relay":{"code":"NJ-003","title":"驛舍急信","loc":"南京驛舍","text":["驛舍廊下掛著還未乾的馬具。驛卒將北路信匣推入櫃內，匣面朱筆寫著「銀川」。","若要問，得先讓對方相信你有正當來由。"],"choices":[{"text":"用官樣話問銀川急信","to":"Yamen","kind":"question","skill":"office","dc":10,"fx":{"suspicion":1},"gain":"銀川急信線索"},{"text":"稱自己受人所託，問送信路線","to":"NorthStreet","kind":"negotiation","skill":"social","dc":10,"fx":{"suspicion":2,"fatigue":1},"gain":"北路送信圖"},{"text":"離開驛舍","to":"Gate","kind":"action","skill":null,"dc":0,"fx":{}}]},
    "River":{"code":"NJ-004","title":"秦淮河埠","loc":"秦淮河埠","text":["河水把天色映得發灰。貨箱上有江郡、盧陵、南陽幾處戳記，搬夫說這兩月船期變得奇怪。","你今日不離南京，只能從船工口中問出江夏與南陽的線。"],"choices":[{"text":"查貨箱戳記與收貨名","to":"Ledger","kind":"action","skill":"appraise","dc":10,"fx":{"fatigue":2},"gain":"南合商會戳記"},{"text":"向船主問江夏糧船","to":"Rest","kind":"question","skill":"speech","dc":10,"fx":{"coin":-1},"gain":"江夏糧船消息"},{"text":"回南京外城","to":"Gate","kind":"action","skill":null,"dc":0,"fx":{}}]},
    "Ledger":{"code":"NJ-005","title":"南市帳房","loc":"南京南市","text":["南市帳房裡，算籌壓著一張改過數次的借據。南合商會的名號反覆出現，收貨與付款卻分開走。","帳房先生說，南陽最近像有人在暗處堆薪。"],"choices":[{"text":"比對南陽與江郡兩筆帳","to":"Ledger","kind":"action","skill":"office","dc":10,"fx":{"fatigue":2},"gain":"南陽帳目疑點"},{"text":"問帳房先生劉廷平的名號","to":"Rest","kind":"question","skill":"court","dc":10,"fx":{"suspicion":1},"gain":"劉廷平舊名"},{"text":"回茶棚","to":"Tea","kind":"action","skill":null,"dc":0,"fx":{}}]},
    "Kunlun":{"code":"NJ-006","title":"南京西街書肆","loc":"南京西街","text":["書肆門口掛著淡紫穗結。店主看見你提到崑崙，先看你的鞋，再看你的袖。","街口道童匆匆買紙。你聽見「崑崙受襲」四字，又聽見銀川與下山。"],"choices":[{"text":"追問道童消息來源","to":"NorthStreet","kind":"question","skill":"empathy","dc":10,"fx":{"suspicion":1},"gain":"崑崙受襲傳聞"},{"text":"用宗教典故試探店主","to":"Rest","kind":"question","skill":"religion","dc":10,"fx":{"composure":1},"gain":"崑崙書肆信物"},{"text":"回茶棚","to":"Tea","kind":"action","skill":null,"dc":0,"fx":{}}]},
    "Alley":{"code":"NJ-007","title":"後巷青衣人","loc":"南京後巷","text":["青衣商旅在後巷停下，從袖中取出小紙包，交給賣香人。","他們說到「五月十六」與「崑崙山門」，又說南陽那邊已壓不住。"],"choices":[{"text":"記住紙包封法","to":"Relay","kind":"action","skill":"observe","dc":8,"fx":{"fatigue":1},"gain":"青衣紙包封法"},{"text":"上前裝作問路","to":"Ledger","kind":"negotiation","skill":"speech","dc":10,"fx":{"suspicion":2},"gain":"南陽異動口供"},{"text":"翻牆避開巡丁","to":"Gate","kind":"action","skill":"climb","dc":10,"fx":{"fatigue":3,"suspicion":-1}}]},
    "Yamen":{"code":"NJ-008","title":"官署門廊","loc":"南京官署","text":["官署門廊掛著潮氣。老書吏不願多談北路，只說魏無紛在銀川，魏無忌在朝中。","他提醒你，問得太多會讓名字落到錯的人手裡。"],"choices":[{"text":"查魏無忌近年任官","to":"Rest","kind":"action","skill":"office","dc":12,"fx":{"suspicion":2,"fatigue":2},"gain":"魏無忌任官摘記"},{"text":"問魏無紛與銀川守備","to":"NorthStreet","kind":"question","skill":"court","dc":10,"fx":{"suspicion":1},"gain":"銀川守備傳聞"},{"text":"離開官署","to":"Gate","kind":"action","skill":null,"dc":0,"fx":{}}]},
    "NorthStreet":{"code":"NJ-010","title":"南京北街","loc":"南京北街","text":["北街風大，賣馬人把韁繩繞在柱上。有人說崑崙受突厥攻擊後，有人下山，又有人往銀川。","你不離南京，只能請人帶信、打聽名聲，或把可疑線索留到夜裡細想。"],"choices":[{"text":"請馬客帶信往銀川","to":"Rest","kind":"negotiation","skill":"wealth","dc":10,"fx":{"coin":-3,"fatigue":1},"need":"銀川急信線索","gain":"銀川回信約定"},{"text":"打聽魏無紛名聲","to":"Yamen","kind":"question","skill":"jianghu","dc":8,"fx":{"coin":-1},"gain":"魏無紛名聲"},{"text":"回南京外城","to":"Gate","kind":"action","skill":null,"dc":0,"fx":{}}]},
    "Training":{"code":"NJ-015","title":"溫課練功","loc":"借住小院","text":["小院燈光偏黃。你可以讀書、請教、演練，也可以停下來養神。"],"choices":[{"text":"研讀政務案牘","to":"TrainingResult","kind":"training","skill":"office","dc":8,"fx":{"fatigue":2,"hunger":1},"train":"office"},{"text":"演練輕功步法","to":"TrainingResult","kind":"training","skill":"light","dc":8,"fx":{"fatigue":4,"hunger":2},"train":"light"},{"text":"請人講江湖門路","to":"TrainingResult","kind":"training","skill":"jianghu","dc":8,"fx":{"coin":-1,"composure":1},"train":"jianghu"},{"text":"回南京外城","to":"Gate","kind":"action","skill":null,"dc":0,"fx":{}}]},
    "TrainingResult":{"code":"NJ-016","title":"修習結果","loc":"借住小院","text":["{{last}}"],"choices":[{"text":"繼續修習","to":"Training","kind":"training","skill":null,"dc":0,"fx":{}},{"text":"回南京外城","to":"Gate","kind":"action","skill":null,"dc":0,"fx":{}},{"text":"歇息一會兒","to":"Rest","kind":"action","skill":null,"dc":0,"fx":{"fatigue":-15,"hunger":-5,"spirit":6}}]},
    "Rest":{"code":"NJ-017","title":"歇息","loc":"借住小院","text":["風從窗縫裡進來。你把衣襟攏緊，讓呼吸慢下來。","短暫歇息不能消除所有麻煩，但足以讓你接著行動。"],"choices":[{"text":"睡到天明","to":"Gate","kind":"action","skill":null,"dc":0,"fx":{"spirit":18,"composure":8,"fatigue":-30,"hunger":-12,"suspicion":-1}},{"text":"溫課練功","to":"Training","kind":"training","skill":null,"dc":0,"fx":{}},{"text":"查看南京路線","to":"Map","kind":"action","skill":null,"dc":0,"fx":{}}]},
    "Map":{"code":"NJ-018","title":"南京路線圖","loc":"隨身小圖","text":["小圖只畫南京：外城、茶棚、驛舍、秦淮河埠、南市、官署、北街與西街書肆。","遠方諸地皆在紙上，不在今日腳下。"],"choices":[{"text":"去外城","to":"Gate","kind":"action","skill":null,"dc":0,"fx":{}},{"text":"去南市帳房","to":"Ledger","kind":"action","skill":null,"dc":0,"fx":{}},{"text":"去官署","to":"Yamen","kind":"action","skill":null,"dc":0,"fx":{}},{"text":"去秦淮河埠","to":"River","kind":"action","skill":null,"dc":0,"fx":{}}]}
  }
