{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://da-go.invalid/schemas/worldops-module-manifest.schema.json",
  "title": "WorldOps Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "dependencies", "capabilities", "dataAuthority", "canonWriteAllowed"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dataAuthority": { "enum": ["client-cache", "server-command", "server-readonly"] },
    "canonWriteAllowed": { "const": false }
  }
}
